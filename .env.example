# SatExpert Tactical SatCom Intelligence (TSI)
# Environment Configuration Template
# Duplicate this file as .env and populate with your credentials.

# Google Gemini AI API Key (Required for AI Technician & Automated Threat Port Scan Intelligence)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Application Port (Default: 3000)
PORT=3000

# Optional: Node Environment ('development' | 'production')
NODE_ENV=development
